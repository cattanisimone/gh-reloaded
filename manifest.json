{
  "manifest_version": 3,
  "name": "GH Reloaded",
  "version": "0.2.0",
  "description": "A growing set of small injected UI enhancements for GitHub. First feature: a left-to-right dependency graph below an issue's sub-issues list.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GH Reloaded — Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*/issues/*",
        "https://github.com/orgs/*/projects/*",
        "https://github.com/users/*/projects/*"
      ],
      "js": ["features/dependency-graph/layout.js", "features/dependency-graph/content.js"],
      "css": ["features/dependency-graph/content.css"],
      "run_at": "document_idle"
    }
  ]
}
