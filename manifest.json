{
  "manifest_version": 3,
  "name": "GH Reloaded",
  "version": "0.5.0",
  "description": "Small UI enhancements for GitHub: dependency graphs, quick-create, board dependency arrows, full-width boards, HTML previews.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GH Reloaded — Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*/issues/*",
        "https://github.com/orgs/*/projects/*",
        "https://github.com/users/*/projects/*"
      ],
      "js": ["features/dependency-graph/layout.js", "features/dependency-graph/content.js"],
      "css": ["features/dependency-graph/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/orgs/*/projects/*",
        "https://github.com/users/*/projects/*"
      ],
      "js": ["features/quick-create/content.js"],
      "css": ["features/quick-create/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/orgs/*/projects/*",
        "https://github.com/users/*/projects/*"
      ],
      "js": ["features/board-dependencies/content.js"],
      "css": ["features/board-dependencies/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/orgs/*/projects/*",
        "https://github.com/users/*/projects/*"
      ],
      "js": ["features/full-width-board/content.js"],
      "css": ["features/full-width-board/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/*/*/pull/*/files*",
        "https://github.com/*/*/pull/*/changes*",
        "https://github.com/*/*/blob/*"
      ],
      "js": ["features/html-preview/content.js"],
      "css": ["features/html-preview/content.css"],
      "run_at": "document_idle"
    }
  ],
  "sandbox": {
    "pages": ["features/html-preview/sandbox.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src * 'unsafe-inline' 'unsafe-eval'; style-src * 'unsafe-inline'; img-src * data: blob:; font-src * data:; connect-src *; frame-src *; child-src *; base-uri *; object-src *;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "features/html-preview/preview.html",
        "features/html-preview/preview.css",
        "features/html-preview/preview.js",
        "features/html-preview/sandbox.html",
        "features/html-preview/sandbox.js"
      ],
      "matches": ["https://github.com/*"]
    }
  ]
}
